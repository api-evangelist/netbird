{
  "opencollection": "1.0.0",
  "info": {
    "name": "NetBird REST Accounts Usage API",
    "version": "0.0.1"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Usage",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get current usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.netbird.io/api/integrations/billing/usage"
          },
          "docs": "Get current usage"
        }
      ]
    }
  ],
  "bundled": true
}