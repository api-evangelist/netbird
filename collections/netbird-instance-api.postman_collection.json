        {
          "id": "04cfa0c8-4502-4ee9-ba69-cff8f08f3b17",
          "name": "Setup Instance",
          "request": {
            "name": "Setup Instance",
            "description": {
              "content": "Creates the initial admin user for the instance. This endpoint does not require authentication but only works when setup is required (no accounts exist and embedded IDP is enabled).\n\nWhen the management server is started with `NB_SETUP_PAT_ENABLED=true` and the request includes `create_pat: true`, the endpoint also provisions the NetBird account for the new owner user and returns the plain text Personal Access Token in `personal_access_token`. The optional `pat_expire_in` value applies only when `create_pat` is true and defaults to 1 day when omitted. If a post-user step fails, setup-created resources are rolled back when safe; if account cleanup fails, the owner user is left in place to avoid leaving an account without its admin user.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "setup"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"<string>\",\n  \"password\": \"<password>\",\n  \"name\": \"<string>\",\n  \"create_pat\": \"<boolean>\",\n  \"pat_expire_in\": 1\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "ca400853-bc28-455b-9cad-b5f166171dfc",
              "name": "Setup completed successfully",
              "originalRequest": {
                "url": {
                  "path": [
                    "api",
                    "setup"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"securepassword123\",\n  \"name\": \"Admin User\",\n  \"create_pat\": true,\n  \"pat_expire_in\": 30\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "disabled": false,
                  "description": "Always set to no-store because the response may contain a one-time plain text Personal Access Token.",
                  "key": "Cache-Control",
                  "value": "no-store"
                },
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"user_id\": \"abc123def456\",\n  \"email\": \"admin@example.com\",\n  \"personal_access_token\": \"nbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx\"\n}",
              "cookie": [],
