          "name": "Bypass compliance for a non-compliant peer",
          "request": {
            "name": "Bypass compliance for a non-compliant peer",
            "description": {
              "content": "Allows an admin to bypass EDR compliance checks for a specific peer.\nThe peer will remain bypassed until the admin revokes it OR the device becomes\nnaturally compliant in the EDR system.\n",
              "type": "text/plain"
            },
